{
  "name": "agents-obsidian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "inbox": "dist/inbox.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/e2e",
    "e2e": "npm run build && wdio run wdio.conf.mts",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wdio-obsidian-service": "^3.5.0"
  }
}
